# Local development secrets. Copy this file to `.env` (gitignored) and edit the values.
# These are DEV-ONLY credentials for the throwaway local Postgres/Keycloak — never reuse
# them anywhere non-local. Every value here is consumed by docker-compose.yml and/or the
# backend (application.properties) and keycloak/render-realm.mjs.

# Postgres (docker-compose db service + backend spring.datasource)
DB_USERNAME=claims
DB_PASSWORD=claims

# Keycloak bootstrap admin (docker-compose keycloak service)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Provisioned realm users (keycloak/render-realm.mjs -> realm-export.json).
# Customers: every policy holder has a pre-provisioned claimant login whose email
# matches policy.holder_email (the cockpit link key) — see
# keycloak/realm-export.template.json. Staff: adjusters + supervisor.
ADJUSTER_PASSWORD=adjuster-Pass-123
SUPERVISOR_PASSWORD=supervisor-Pass-123
CLAIMANT_PASSWORD=claims-Pass-123

# S2 S3-compatible object storage (MinIO dev in docker-compose.yml, real S3 in
# prod). Dev defaults match the MinIO service; prod overrides via environment.
# Never commit real credentials — these are dev-only placeholders.
CLAIMS_S3_ENDPOINT=http://localhost:9000
CLAIMS_S3_BUCKET=claims-evidence
CLAIMS_S3_REGION=us-east-1
CLAIMS_S3_ACCESS_KEY=minioadmin
CLAIMS_S3_SECRET_KEY=minioadmin

# V26 (V3 S11): display locale + tenant timezone (backend application.properties
# claims.locale.default / claims.timezone.default; the SPA mirrors via Intl).
# Dev defaults: British English formats + Europe/London day-boundaries.
CLAIMS_LOCALE_DEFAULT=en-GB
CLAIMS_TIMEZONE_DEFAULT=Europe/London
